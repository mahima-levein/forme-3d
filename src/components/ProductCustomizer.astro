---
import { Box, RotateCcw, Upload, X } from "@lucide/astro";
import { GARMENT_COLORS } from "../scripts/product-customizer/colors";
---

<div data-shirt-customizer>
  <button
    type="button"
    data-open-customizer
    class="inline-flex items-center gap-2.5 border border-[#c97834] bg-[#c97834] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#ad632a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#c97834]"
  >
    <Box size={17} stroke-width={1.8} aria-hidden="true" />
    Open 3D customizer
  </button>

  <dialog
    data-customizer-dialog
    aria-labelledby="shirt-customizer-title"
    aria-describedby="shirt-customizer-description"
    class="m-auto h-[min(800px,calc(100dvh-40px))] w-[min(1280px,calc(100vw-40px))] max-h-none max-w-none overflow-hidden border border-black/15 bg-[#f4f4f2] p-0 text-[#1c211f] shadow-2xl backdrop:bg-[#17201d]/75 max-[760px]:h-dvh max-[760px]:w-screen max-[760px]:border-0"
  >
    <div class="flex h-full min-h-0 flex-col">
      <header class="flex items-center justify-between border-b border-black/10 bg-white px-5 py-4 sm:px-7">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#c97834]">3D workwear studio</p>
          <h2 id="shirt-customizer-title" class="mt-1 font-display text-xl font-bold tracking-[-0.025em] sm:text-2xl">
            Customize your men's shirt
          </h2>
          <p id="shirt-customizer-description" class="sr-only">Upload and position a logo on an interactive three-dimensional men's shirt.</p>
        </div>
        <button
          type="button"
          data-close-customizer
          class="ml-4 grid h-10 w-10 shrink-0 place-items-center rounded-full border border-black/10 bg-[#f7f7f5] transition hover:bg-[#ececea] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#c97834]"
          aria-label="Close customizer"
        >
          <X size={18} stroke-width={1.8} aria-hidden="true" />
        </button>
      </header>

      <div class="grid min-h-0 flex-1 grid-cols-[minmax(0,1.65fr)_minmax(320px,0.85fr)] max-[760px]:grid-cols-1 max-[760px]:grid-rows-[46dvh_minmax(0,1fr)]">
        <section class="relative min-h-0 overflow-hidden bg-[#e8e9e7]" aria-label="Interactive 3D product preview">
          <div data-viewer class="absolute inset-0 touch-none">
            <canvas data-three-canvas class="block h-full w-full" aria-label="Rotatable 3D men's shirt"></canvas>
          </div>
          <div data-loading class="pointer-events-none absolute inset-0 grid place-items-center bg-[#e8e9e7]" role="status" aria-live="polite">
            <div class="text-center">
              <span class="mx-auto block h-8 w-8 animate-spin rounded-full border-2 border-black/15 border-t-[#c97834]"></span>
              <p class="mt-4 text-sm font-medium text-[#555]">Loading 3D preview...</p>
            </div>
          </div>
          <div data-load-error hidden class="absolute inset-0 grid place-items-center bg-[#e8e9e7] px-6 text-center" role="alert">
            <div>
              <p class="font-display text-xl font-semibold">Unable to load 3D preview.</p>
              <p class="mt-2 text-sm text-[#666]">Check that mens-shirt.glb is available in public/models.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute bottom-4 left-4 rounded-full bg-white/80 px-3 py-1.5 text-xs text-black/55 shadow-sm backdrop-blur-sm">
            Drag to rotate · Scroll or pinch to zoom
          </div>
        </section>

        <aside class="min-h-0 overflow-y-auto bg-white px-5 py-5 sm:px-6" aria-label="Logo customization controls">
          <section>
            <h3 class="font-display text-lg font-bold">Garment color</h3>
            <div data-garment-color-swatches class="mt-3 flex flex-wrap gap-2">
              {GARMENT_COLORS.map((color) => (
                <button
                  type="button"
                  data-garment-color={color.key}
                  data-active="false"
                  title={color.label}
                  aria-label={color.label}
                  aria-pressed="false"
                  style={`background-color:${color.hex}`}
                  class="h-9 w-9 min-w-9 shrink-0 rounded-full border border-black/15 shadow-sm transition hover:scale-105 hover:border-black/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#c97834] data-[active=true]:border-2 data-[active=true]:border-[#c97834] data-[active=true]:ring-2 data-[active=true]:ring-[#c97834]/30"
                />
              ))}
              <input
                type="color"
                data-garment-color-custom
                aria-label="Custom garment color"
                title="Custom color"
                class="h-9 w-9 min-w-9 shrink-0 cursor-pointer rounded-full border border-black/15 p-0.5"
              />
            </div>
          </section>

          <div class="my-5 h-px bg-black/10"></div>

          <section>
            <h3 class="font-display text-lg font-bold">Upload logo</h3>
            <label class="mt-3 flex cursor-pointer items-center justify-center gap-2 border border-dashed border-black/25 bg-[#fafaf8] px-4 py-4 text-sm font-semibold transition hover:border-[#c97834] hover:bg-[#fffaf5]">
              <Upload size={17} stroke-width={1.8} aria-hidden="true" />
              Choose logo
              <input data-logo-input type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" />
            </label>
            <p data-file-name class="mt-2 truncate text-xs text-[#777]">PNG, JPEG or WebP</p>
          </section>

          <div class="my-5 h-px bg-black/10"></div>

          <label class="block text-sm font-semibold" for="shirt-placement">Placement</label>
          <select id="shirt-placement" data-placement disabled class="mt-2 w-full border border-black/20 bg-white px-3 py-3 text-sm disabled:cursor-wait disabled:opacity-50"></select>

          <section data-calibration-panel hidden class="mt-4 border border-amber-300 bg-amber-50 p-3">
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-amber-900">Developer calibration</p>
            <label class="mt-2 block text-sm font-semibold" for="shirt-calibration-placement">Surface to calibrate</label>
            <select id="shirt-calibration-placement" data-calibration-placement class="mt-2 w-full border border-amber-400 bg-white px-3 py-2.5 text-sm"></select>
            <p data-calibration-status class="mt-2 text-xs leading-5 text-amber-950">Choose a location, orient the shirt, then click the real garment surface. Dragging still rotates the model.</p>
          </section>

          <div class="mt-5 space-y-5">
            <label class="block">
              <span class="flex justify-between text-sm font-semibold"><span>Logo size</span><output data-output="size" class="font-normal text-[#777]">55%</output></span>
              <input data-logo-setting="size" type="range" min="0.2" max="1" step="0.01" value="0.55" class="mt-2 w-full accent-[#c97834]" />
            </label>
            <label class="block">
              <span class="flex justify-between text-sm font-semibold"><span>Horizontal position</span><output data-output="x" class="font-normal text-[#777]">0%</output></span>
              <input data-logo-setting="x" type="range" min="-50" max="50" step="1" value="0" class="mt-2 w-full accent-[#c97834]" />
            </label>
            <label class="block">
              <span class="flex justify-between text-sm font-semibold"><span>Vertical position</span><output data-output="y" class="font-normal text-[#777]">0%</output></span>
              <input data-logo-setting="y" type="range" min="-50" max="50" step="1" value="0" class="mt-2 w-full accent-[#c97834]" />
            </label>
            <label class="block">
              <span class="flex justify-between text-sm font-semibold"><span>Rotation</span><output data-output="rotation" class="font-normal text-[#777]">0°</output></span>
              <input data-logo-setting="rotation" type="range" min="-180" max="180" step="1" value="0" class="mt-2 w-full accent-[#c97834]" />
            </label>
          </div>

          <div class="my-5 h-px bg-black/10"></div>

          <fieldset>
            <legend class="text-sm font-semibold">Product view</legend>
            <div class="mt-3 grid grid-cols-4 gap-2">
              <button data-view="front" data-active="true" type="button" class="border border-black/15 px-2 py-2.5 text-xs font-semibold transition hover:border-black/40 data-[active=true]:border-[#c97834] data-[active=true]:bg-[#fff5ec] data-[active=true]:text-[#a95820]">Front</button>
              <button data-view="back" type="button" class="border border-black/15 px-2 py-2.5 text-xs font-semibold transition hover:border-black/40 data-[active=true]:border-[#c97834] data-[active=true]:bg-[#fff5ec] data-[active=true]:text-[#a95820]">Back</button>
              <button data-view="left" type="button" class="border border-black/15 px-2 py-2.5 text-xs font-semibold transition hover:border-black/40 data-[active=true]:border-[#c97834] data-[active=true]:bg-[#fff5ec] data-[active=true]:text-[#a95820]">Left</button>
              <button data-view="right" type="button" class="border border-black/15 px-2 py-2.5 text-xs font-semibold transition hover:border-black/40 data-[active=true]:border-[#c97834] data-[active=true]:bg-[#fff5ec] data-[active=true]:text-[#a95820]">Right</button>
            </div>
          </fieldset>

          <button data-reset type="button" class="mt-6 inline-flex w-full items-center justify-center gap-2 border border-black/25 px-4 py-3 text-sm font-semibold transition hover:bg-[#f4f4f2]">
            <RotateCcw size={16} stroke-width={1.8} aria-hidden="true" />
            Reset customization
          </button>
        </aside>
      </div>
    </div>
  </dialog>
</div>

<script>
  import { initializeShirtCustomizer } from "../scripts/product-customizer/viewer";

  const roots = document.querySelectorAll<HTMLElement>("[data-shirt-customizer]");
  for (const root of roots) {
    if (root.dataset.initialized === "true") continue;
    root.dataset.initialized = "true";
    const dispose = initializeShirtCustomizer(root);
    document.addEventListener("astro:before-swap", dispose, { once: true });
  }
</script>
